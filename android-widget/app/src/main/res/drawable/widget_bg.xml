<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="28dp"/>
            <gradient android:angle="135" android:startColor="#B83B536D" android:centerColor="#A51C3048" android:endColor="#D90A1525"/>
            <stroke android:width="1.2dp" android:color="#A8FFFFFF"/>
        </shape>
    </item>
    <item android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="27dp"/>
            <gradient android:angle="90" android:startColor="#38FFFFFF" android:centerColor="#08FFFFFF" android:endColor="#02FFFFFF"/>
        </shape>
    </item>
</layer-list>