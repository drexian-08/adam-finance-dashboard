<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="19dp"/>
            <gradient android:angle="135" android:startColor="#48FFFFFF" android:centerColor="#20FFFFFF" android:endColor="#12C7E5FF"/>
            <stroke android:width="1dp" android:color="#70FFFFFF"/>
        </shape>
    </item>
    <item android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="18dp"/>
            <gradient android:angle="90" android:startColor="#20FFFFFF" android:endColor="#00FFFFFF"/>
        </shape>
    </item>
</layer-list>